		"primaryCtaTarget": {
			"type": "boolean",
			"default": false
		},
		"secondaryCtaText": {
			"type": "string",
			"default": ""
		},
		"secondaryCtaUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryCtaTarget": {
			"type": "boolean",
			"default": false
		},
		"backgroundImageId": {
			"type": "number",
