{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-hesis2026/cb-hero",
	"title": "CB Hero",
	"category": "cb-hesis2026",
	"icon": "cover-image",
	"attributes": {
		"kicker": {
			"type": "string",
			"default": ""
